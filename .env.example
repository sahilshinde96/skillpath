# SkillSprint Environment Configuration

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: If left blank or unset in local development, Django will gracefully fall back to local SQLite.
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillsprint

# Django Secret Key (Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=django-insecure-skillpath-secret-key-change-in-prod-2026

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Google OAuth2 Credentials (from Google Cloud Console)
# Used by Django backend to verify ID token audience
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Used by React frontend (Vercel) to initialize Google Sign-In button
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# BlackSMS Infrastructure (blacksms.in) API Configuration
# Used by Django backend to dispatch 2FA SMS verification passcodes
BLACKSMS_API_KEY=your_blacksms_api_key_here
BLACKSMS_API_URL=https://blacksms.in/api/v1/bulk-sms
BLACKSMS_SENDER_ID=
BLACKSMS_DLT_TEMPLATE_ID=
